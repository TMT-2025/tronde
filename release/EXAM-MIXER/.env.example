# ==============================================================================
# EXAM MIXER - CẤU HÌNH MÔI TRƯỜNG MẪU (.env.example)
# Sao chép tệp này thành .env nếu muốn tùy chỉnh cấu hình mặc định.
# Ứng dụng hoạt động với các giá trị mặc định mà không cần tệp .env.
# ==============================================================================

# Cổng lắng nghe của máy chủ Web (Mặc định: 3000)
PORT=3000

# Địa chỉ IP lắng nghe (Mặc định: 0.0.0.0 để chấp nhận kết nối nội bộ hoặc mạng LAN trường học)
HOST=0.0.0.0

# Chế độ chạy môi trường (production / development)
NODE_ENV=production
